# Backend environment
PORT=5001
NODE_ENV=development

# Database (configure MySQL to use persistent storage; otherwise local fallback may use in-memory SQLite)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=online_exam_system

# Password reset email (SMTP). Example values below are placeholders.
# For Gmail, use smtp.gmail.com:587 and a Google App Password (not your account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_sender_email@gmail.com
SMTP_PASS=your_16_character_google_app_password
SMTP_FROM=PrepMaster <your_sender_email@gmail.com>

# Frontend URL used in reset links; set this to your actual Vite/production URL.
FRONTEND_URL=http://localhost:3002
